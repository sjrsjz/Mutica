let constraint a: nat = 2;
let constraint b: nat = 3;
let assert 5 = a + b;
let assert 6 = a * b;
let assert 1 = b - a;
let assert 0 = a / b;
let assert 2 = a % b;
let assert true = a < b;
let assert false = a > b;
let assert true = a <= b;
let assert false = a >= b;
let assert true = a == 2;
let assert false = a != 2;
let assert true = b == 3;
let assert false = b != 3;
"Success"