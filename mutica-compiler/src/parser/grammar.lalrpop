use crate::parser::ast::TypeAst;
use lalrpop_util::ErrorRecovery;
use crate::parser::lexer::{LexerToken, LexicalError};
use mutica_core::util::source_info::SourceFile;
use mutica_core::util::source_info::SourceLocation;
use mutica_core::util::colorize::TokenColor;
use crate::parser::WithLocation;
use crate::parser::calculate_full_error_span;
use std::num::NonZero;
use std::sync::Arc;
use crate::parser::ast::GenericPattern;
grammar(source: &Arc<SourceFile>, colors: &mut Vec<TokenColor>);



extern {
    type Location = usize;
    type Error = LexicalError;

    enum LexerToken {
        "Wildcard"      => LexerToken::Wildcard,
        "FloatNum"      => LexerToken::FloatNum(<f64>),
        "Num"           => LexerToken::Num(<usize>),
        "Ident"         => LexerToken::Ident(<String>),
        "CharLit"       => LexerToken::CharLit(<char>),
        "StringLit"     => LexerToken::StringLit(<String>),

        "Let"           => LexerToken::Let,
        "With"          => LexerToken::With,
        "Where"         => LexerToken::Where,
        "Exist"         => LexerToken::Exist,
        "Assert"        => LexerToken::Assert,
        "Match"         => LexerToken::Match,
        "Rec"           => LexerToken::Rec,
        "DynamicRec"    => LexerToken::DynamicRec,
        "Loop"          => LexerToken::Loop,
        "Panic"         => LexerToken::Panic,
        "Discard"       => LexerToken::Discard,
        "Nat"           => LexerToken::Nat,
        "Char"          => LexerToken::Char,
        "Float"         => LexerToken::Float,
        "True"          => LexerToken::True,
        "False"         => LexerToken::False,
        "Any"           => LexerToken::Any,
        "None"          => LexerToken::None,
        "Import"        => LexerToken::Import,
        "If"            => LexerToken::If,
        "Then"          => LexerToken::Then,
        "Else"          => LexerToken::Else,
        "Rot"           => LexerToken::Rot,
        "Handle"        => LexerToken::Handle,
        "EqOf"          => LexerToken::EqOf,
        "SubOf"         => LexerToken::SubOf,
        "Type"          => LexerToken::Type,
        "For"           => LexerToken::For,
        "In"            => LexerToken::In,
        "Extend"        => LexerToken::Extend,
        "As"            => LexerToken::As,
        "Constraint"    => LexerToken::Constraint,

        "Arrow"         => LexerToken::Arrow,
        "FatArrow"      => LexerToken::FatArrow,
        "DoubleArrow"   => LexerToken::DoubleArrow,
        "DoubleColon"   => LexerToken::DoubleColon,
        "Dot"           => LexerToken::Dot,
        "At"            => LexerToken::At,
        "Pipe"          => LexerToken::Pipe,
        "DoublePipe"    => LexerToken::DoublePipe,
        "Bang"          => LexerToken::Bang,
        "Colon"         => LexerToken::Colon,
        "Tilde"         => LexerToken::Tilde,
        "Comma"         => LexerToken::Comma,
        "Ampersand"     => LexerToken::Ampersand,
        "DoubleAmpersand" => LexerToken::DoubleAmpersand,
        "Eq"            => LexerToken::Eq,
        "Neq"           => LexerToken::Neq,
        "Lt"            => LexerToken::Lt,
        "Lte"           => LexerToken::Lte,
        "Gt"            => LexerToken::Gt,
        "Gte"           => LexerToken::Gte,
        "Is"            => LexerToken::Is,
        "Plus"          => LexerToken::Plus,
        "Minus"         => LexerToken::Minus,
        "Star"          => LexerToken::Star,
        "Slash"         => LexerToken::Slash,
        "Percent"       => LexerToken::Percent,
        "Assign"        => LexerToken::Assign,
        "Semicolon"     => LexerToken::Semicolon,
        "Hash"          => LexerToken::Hash,
        "Backslash"     => LexerToken::Backslash,
        "LParen"        => LexerToken::LParen,
        "RParen"        => LexerToken::RParen,
        "LBracket"      => LexerToken::LBracket,
        "RBracket"      => LexerToken::RBracket,
        "LBrace"        => LexerToken::LBrace,
        "RBrace"        => LexerToken::RBrace,
        "PipeGreaterThan" => LexerToken::PipeGreaterThan,
        "Range"         => LexerToken::Range,
        "Dollar"        => LexerToken::Dollar,
    }
}

Num: usize = <l:@L> <s:"Num"> <r:@R> => {
    TokenColor::fill_colors(colors, l..r, TokenColor::Number);
    s
};

Float: f64 = <l:@L> <s:"FloatNum"> <r:@R> => {
    TokenColor::fill_colors(colors, l..r, TokenColor::Number);
    s
};

Ident: String = {
    <l:@L> <s:"Ident"> <r:@R> => {
        TokenColor::fill_colors(colors, l..r, TokenColor::Identifier);
        s
    },
    <l:@L> DollarTok <s:"StringLit"> <r:@R> => {
        TokenColor::fill_colors(colors, l..r, TokenColor::Identifier);
        s
    }
};

StringLiteral: String = {
    <l:@L> <s:"StringLit"> <r:@R> => {
        TokenColor::fill_colors(colors, l..r, TokenColor::String);
        s
    }
};

CharLiteral: char = {
    <l:@L> <c:"CharLit"> <r:@R> => {
        TokenColor::fill_colors(colors, l..r, TokenColor::String);
        c
    }
}

// --- Token nonterminals: centralize coloring logic ---

NatTok: () = <l:@L> "Nat" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
FloatTok: () = <l:@L> "Float" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
CharTok: () = <l:@L> "Char" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
TrueTok: () = <l:@L> "True" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
FalseTok: () = <l:@L> "False" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
AnyTok: () = <l:@L> "Any" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
WildcardTok: () = <l:@L> "Wildcard" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };
NoneTok: () = <l:@L> "None" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Type); () };

// Individual keyword tokens (keeps locations simple and centralizes coloring)
LetTok: () = <l:@L> "Let" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
WithTok: () = <l:@L> "With" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
WhereTok: () = <l:@L> "Where" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ExistTok: () = <l:@L> "Exist" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
AssertTok: () = <l:@L> "Assert" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
MatchTok: () = <l:@L> "Match" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
RecTok: () = <l:@L> "Rec" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
DynamicRecTok: () = <l:@L> "DynamicRec" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
LoopTok: () = <l:@L> "Loop" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
PanicTok: () = <l:@L> "Panic" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
DiscardTok: () = <l:@L> "Discard" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ImportTok: () = <l:@L> "Import" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
IfTok: () = <l:@L> "If" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ThenTok: () = <l:@L> "Then" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ElseTok: () = <l:@L> "Else" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
RotTok: () = <l:@L> "Rot" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
HandleTok: () = <l:@L> "Handle" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
EqOfTok: () = <l:@L> "EqOf" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
SubOfTok: () = <l:@L> "SubOf" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
TypeTok: () = <l:@L> "Type" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ForTok: () = <l:@L> "For" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
InTok: () = <l:@L> "In" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ExtendTok: () = <l:@L> "Extend" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
AsTok: () = <l:@L> "As" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
ConstraintTok: () = <l:@L> "Constraint" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };

// Individual operator tokens with centralized coloring
DotTok: () = <l:@L> "Dot" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
DoubleColonTok: () = <l:@L> "DoubleColon" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
AtTok: () = <l:@L> "At" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
PipeTok: () = <l:@L> "Pipe" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
DoublePipeTok: () = <l:@L> "DoublePipe" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
BangTok: () = <l:@L> "Bang" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
ColonTok: () = <l:@L> "Colon" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
TildeTok: () = <l:@L> "Tilde" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
AmpersandTok: () = <l:@L> "Ampersand" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
DoubleAmpersandTok: () = <l:@L> "DoubleAmpersand" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
EqTok: () = <l:@L> "Eq" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
NeqTok: () = <l:@L> "Neq" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
LtTok: () = <l:@L> "Lt" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
LteTok: () = <l:@L> "Lte" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
GtTok: () = <l:@L> "Gt" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
GteTok: () = <l:@L> "Gte" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
IsTok: () = <l:@L> "Is" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Keyword); () };
PlusTok: () = <l:@L> "Plus" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
MinusTok: () = <l:@L> "Minus" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
StarTok: () = <l:@L> "Star" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
SlashTok: () = <l:@L> "Slash" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
PercentTok: () = <l:@L> "Percent" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
AssignTok: () = <l:@L> "Assign" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
PipeGreaterThanTok: () = <l:@L> "PipeGreaterThan" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
ArrowTok: () = <l:@L> "Arrow" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
FatArrowTok: () = <l:@L> "FatArrow" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
DoubleArrowTok: () = <l:@L> "DoubleArrow" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
RangeTok: () = <l:@L> "Range" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
HashTok: () = <l:@L> "Hash" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
BackslashTok: () = <l:@L> "Backslash" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };
DollarTok: () = <l:@L> "Dollar" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Operator); () };

// Punctuation tokens
LParenTok: () = <l:@L> "LParen" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
RParenTok: () = <l:@L> "RParen" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
LBracketTok: () = <l:@L> "LBracket" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
RBracketTok: () = <l:@L> "RBracket" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
LBraceTok: () = <l:@L> "LBrace" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
RBraceTok: () = <l:@L> "RBrace" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
CommaTok: () = <l:@L> "Comma" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };
SemicolonTok: () = <l:@L> "Semicolon" <r:@R> => { TokenColor::fill_colors(colors, l..r, TokenColor::Punctuation); () };

// --- End token nonterminals ---


AtomType: WithLocation<TypeAst> = {
   <l:@L> NatTok <r:@R> => WithLocation::new(TypeAst::List {
        head: vec![],
        tail: Box::new(WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
    }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> FloatTok <r:@R> => WithLocation::new(TypeAst::Float, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> CharTok <r:@R> => WithLocation::new(TypeAst::Char, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> TrueTok <r:@R> => WithLocation::new(TypeAst::Variable("op#true".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> FalseTok <r:@R> => WithLocation::new(TypeAst::Variable("op#false".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> AnyTok <r:@R> => WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> WildcardTok <r:@R> => WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> NoneTok <r:@R> => WithLocation::new(TypeAst::Bottom, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <f: Float> <r:@R> => WithLocation::new(TypeAst::FloatLiteral(f), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <n: Num> <r:@R> => {
        if n == 0 {
            WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
        } else {
            let unit = WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref());
            WithLocation::new(TypeAst::Tuple(vec![(unit, NonZero::new(n).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
        }
    },
    <l:@L> <id: Ident> <r:@R> => WithLocation::new(TypeAst::Variable(id), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <c: CharLiteral> <r:@R> => WithLocation::new(TypeAst::CharLiteral(c), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <s: StringLiteral> <r:@R> => {
        let chars: Vec<(WithLocation<TypeAst>, NonZero<usize>)> = s.chars().map(|ch| (WithLocation::new(TypeAst::CharLiteral(ch), Some(SourceLocation::new(source.clone(), l..r)).as_ref()), NonZero::new(1).unwrap())).collect();
        WithLocation::new(TypeAst::Tuple(chars), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <io: Ident> BangTok <r:@R> => {
        TokenColor::fill_colors(colors, l..r, TokenColor::Function);
        let op = match io.as_ref() {
            "__add" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Add),
            "__sub" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Sub),
            "__mul" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Mul),
            "__div" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Div),
            "__mod" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Mod),
            "__greater" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Greater),
            "__less" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Less),
            "__is" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Is),
            "__opcode" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Opcode),
            "__neg" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Neg),
            "__build_fixpoint" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::BuildFixPoint),
            "__set" => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::Set),
            _ => TypeAst::AtomicOpcode(crate::parser::ast::AtomicOpcode::IO(io)),
        };
        WithLocation::new(op, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> TypeTok <n:Num> <r:@R> => {
        WithLocation::new(TypeAst::OrderedType(n as usize), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> ImportTok <s: StringLiteral> <r:@R> => {
        WithLocation::new(TypeAst::Import(s), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

AutoBind: WithLocation<TypeAst> = {
    <l:@L> <v_l:@L> <var: Ident> <v_r:@R> ColonTok <t: Factor> <r:@R> => {
        WithLocation::new(TypeAst::Bind {
            var: WithLocation::new(var, Some(SourceLocation::new(source.clone(), v_l..v_r)).as_ref()),
            expr: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

Term: WithLocation<TypeAst> = {
    LParenTok <t: Type> RParenTok => t,
    LBracketTok <t: Type> RBracketTok => t,
    LBraceTok <t: Type> RBraceTok => t,
    <eq: EqOf> => eq,
    <sub: SubOf> => sub,
    <np: Namespace> => np,
    <a: AtomType> => a,
}

Namespace: WithLocation<TypeAst> = {
    <l:@L> <n_l:@L> <tag: Ident> <n_r:@R> DoubleColonTok <t: Term> <r:@R> => {
        TokenColor::fill_colors(colors, n_l..n_r, TokenColor::Namespace);
        WithLocation::new(TypeAst::Namespace {
            tag: tag,
            expr: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

EqOf: WithLocation<TypeAst> = {
    <l:@L> EqOfTok <t: Term> <r:@R> => {
        WithLocation::new(TypeAst::EqOf {
            value: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

SubOf: WithLocation<TypeAst> = {
    <l:@L> SubOfTok <t: Term> <r:@R> => {
        WithLocation::new(TypeAst::SubOf {
            value: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

Apply: WithLocation<TypeAst> = {
    <l:@L> <obj: Apply> DotTok <k: Term> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(k),
            arg: Box::new(obj),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <f: Apply> <x: Term> PipeGreaterThanTok <k: Term> <r:@R> => {
        WithLocation::new(TypeAst::Invoke {
            func: Box::new(f),
            arg: Box::new(x),
            continuation: Some(Box::new(k)),
            perform_handler: None,
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <f: Apply> <x: Term> <r:@R> => WithLocation::new(TypeAst::Apply {
        func: Box::new(f),
        arg: Box::new(x),
    }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <t: Term> => t,
}

IfElse: WithLocation<TypeAst> = {
    <l:@L> IfTok <cond: Primary?> ThenTok <then_branch: Primary> ElseTok <else_branch: Primary> <r:@R> => {
        match cond {
            Some(c) => WithLocation::new(TypeAst::Apply {
                func: Box::new(WithLocation::new(TypeAst::Match {
                    branches: vec![
                        (GenericPattern::Standard {
                            vars: vec![],
                            pattern: WithLocation::new(TypeAst::Variable("op#false".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                            constraint: (
                                WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                                WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                            ),
                        }, else_branch),
                        (GenericPattern::Standard {
                            vars: vec![],
                            pattern: WithLocation::new(TypeAst::Variable("op#true".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                            constraint: (
                                WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                                WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                            ),
                        }, then_branch),
                    ],
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
                arg: Box::new(c),
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
            None => WithLocation::new(TypeAst::Match {
                branches: vec![
                    (GenericPattern::Standard {
                        vars: vec![],
                        pattern: WithLocation::new(TypeAst::Variable("op#false".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                        constraint: (
                            WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                            WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                        ),
                    }, else_branch),
                    (GenericPattern::Standard {
                        vars: vec![],
                        pattern: WithLocation::new(TypeAst::Variable("op#true".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                        constraint: (
                            WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                            WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                        ),
                    }, then_branch),
                ],
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),    
        }
    },
}

Match: WithLocation<TypeAst> = {
    <l:@L> MatchTok <value: Primary?> <branches: MatchBranch*> PipeTok PanicTok? <r:@R> => {
        match value {
            Some(v) => WithLocation::new(TypeAst::Apply {
                func: Box::new(WithLocation::new(TypeAst::Match {
                    branches: branches,
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
                arg: Box::new(v),
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
            None => WithLocation::new(TypeAst::Match {
                branches: branches,
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
        }
    },
}

ForIn: WithLocation<TypeAst> = {
    <l:@L> ForTok <binding: Binding> InTok <expr: Primary> <r:@R> => {
        let (branch, value) = binding;
        WithLocation::new(TypeAst::Apply {
            func: Box::new(value),
            arg: Box::new(WithLocation::new(TypeAst::Match {
                branches: vec![(branch, expr)],
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

FnDef: (GenericPattern, WithLocation<TypeAst>) = {
    <branch: Generic> DoubleArrowTok <expr: Primary> => (branch, expr)
}

MatchBranch: (GenericPattern, WithLocation<TypeAst>) = {
    PipeTok <branch: FnDef> => branch,
}


RecursiveGen: WithLocation<TypeAst> = {
    <l:@L> RecTok <id: Ident> ColonTok <t: Primary> <r:@R> => {
        WithLocation::new(TypeAst::StaticFixPoint {
            param_name: id,
            expr: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> DynamicRecTok <id: Ident> ColonTok <t: Primary> <r:@R> => {
        WithLocation::new(TypeAst::FixPoint {
            param_name: id,
            expr: Box::new(t),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

Closure: WithLocation<TypeAst> = {
    <l:@L> <fn_def: FnDef> <r:@R> => {
        WithLocation::new(TypeAst::Match {
            branches: vec![fn_def],
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

Tuple: WithLocation<TypeAst> = {
    <l:@L> <r:@R> => WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <items: Comma<TupleElementWithNum>> <r:@R> => WithLocation::new(TypeAst::Tuple(items), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <prefix: Comma<TupleElementWithNum>> RangeTok <repeat: TupleElement> <r:@R> => WithLocation::new(TypeAst::List {
            head: prefix,
            tail: Box::new(repeat),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <prefix: Comma<TupleElementWithNum>> TildeTok <repeat: TupleElement> <r:@R> => WithLocation::new(TypeAst::Cons {
            head: prefix,
            tail: Box::new(repeat),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <prefix: TupleElement> RangeTok <repeat: TupleElement> <r:@R> => WithLocation::new(TypeAst::List {
            head: vec![(prefix, NonZero::new(1).unwrap())],
            tail: Box::new(repeat),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <l:@L> <prefix: TupleElement> TildeTok <repeat: TupleElement> <r:@R> => WithLocation::new(TypeAst::Cons {
            head: vec![(prefix, NonZero::new(1).unwrap())],
            tail: Box::new(repeat),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <item: TupleElement> => item,
}

// Define Comma<T> for one or more comma-separated items.
Comma<T>: Vec<T> = {
    <v:(T CommaSep)+> <e:T> => {
        let mut res = Vec::new();
        for (it, _sep) in v.into_iter() {
            res.push(it);
        }
        res.push(e);
        res
    },
    <e:T> CommaSep => vec![e],
};

CommaSep: () = <l:@L> CommaTok+ <r:@R> => ();


Literal: WithLocation<TypeAst> = {
    <l:@L> HashTok <t: Primary> <r:@R> => {
        WithLocation::new(TypeAst::Literal(Box::new(t)), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

DictItems: Vec<WithLocation<String>> = {
    <l:@L> <r:@R> => vec![],
    <l:@L> <key: Ident> <r:@R> => {
        vec![WithLocation::new(key, Some(SourceLocation::new(source.clone(), l..r)).as_ref())]
    },
    <mut items: DictItems> CommaTok <l:@L> <key: Ident> <r:@R> => {
        items.push(WithLocation::new(key, Some(SourceLocation::new(source.clone(), l..r)).as_ref()));
        items
    },
}

GenericVariables: Vec<WithLocation<String>> = {
    LBraceTok <items: DictItems> RBraceTok => items,
    LBracketTok <items: DictItems> RBracketTok => items,
    LParenTok <items: DictItems> RParenTok => items,
    <l:@L> <key: Ident> <r:@R> => vec![WithLocation::new(key, Some(SourceLocation::new(source.clone(), l..r)).as_ref())],
}

// exist {x, ..} T where F: R
Generic: GenericPattern = {
    ExistTok <vars: GenericVariables> InTok <expr: Primary> WhereTok <f: Calculate> AsTok <g: Calculate> => {
        GenericPattern::Standard {
            vars,
            pattern: expr,
            constraint: (f, g),
        }
    },
    <l:@L> AssertTok <expr: Calculate> <r:@R> => {
        GenericPattern::Standard {
            vars: vec![],
            pattern: expr,
            constraint: (
                WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                WithLocation::new(TypeAst::Tuple(vec![]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            ),
        }
    },
    ConstraintTok <pattern: Calculate> => {
        GenericPattern::AutoBind {
            pattern,
        }
    },
}

Constraint: WithLocation<TypeAst> = {
    <l:@L> <pattern: Generic> <r:@R> => {
        WithLocation::new(TypeAst::Generic(pattern.into()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

Primary: WithLocation<TypeAst> = {
    <l: Literal> => l,
    <r: RecursiveGen> => r,
    <c: Constraint> => c,
    <m: Match> => m,
    <c: Closure> => c,
    <f: ForIn> => f,
    <i: IfElse> => i,
    <c: Calculate> => c,
    ! => {
        let err: ErrorRecovery<usize, LexerToken, LexicalError> = <>;
        let (l, r) = calculate_full_error_span(&err);
        TokenColor::fill_colors(colors, l..r, TokenColor::Error);
        WithLocation::new(TypeAst::ParseError(err), None::<&SourceLocation>)
    }
};

Factor: WithLocation<TypeAst> = {
    <l:@L> BangTok <a: Factor> <r:@R> => {
        WithLocation::new(TypeAst::Not {
            value: Box::new(a),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> MinusTok <n: Factor> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#neg".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(n),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <bind: AutoBind> => bind,
    <a: Apply> => a,
}


TupleElementWithNum: (WithLocation<TypeAst>, NonZero<usize>) = {
    <e: TupleElement> => (e, NonZero::new(1).unwrap()),
    <l:@L> <n: Num> AtTok <e: TupleElement> <r:@R> =>? {
        if n <= 0 {
            Err(lalrpop_util::ParseError::User {
                error: LexicalError::InvalidRepeatCount(n, l, r)
            })
        } else {
            Ok((e, NonZero::new(n as usize).unwrap()))
        }
    },
};

TupleElement = Generalize;

Generalize: WithLocation<TypeAst> = {
    <l:@L> <items: Bars<Specialize>> <r:@R> => WithLocation::new(TypeAst::Generalize(items), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <e: Specialize> => e,
}

Bars<T>: Vec<T> = {
    <v:(T BarsSep)+> <e:T> => {
        let mut res = Vec::new();
        for (it, _sep) in v.into_iter() {
            res.push(it);
        }
        res.push(e);
        res
    },
};

BarsSep: () = <l:@L> PipeTok+ <r:@R> => ();

Specialize: WithLocation<TypeAst> = {
    <l:@L> <items: Ands<Primary>> <r:@R> => WithLocation::new(TypeAst::Specialize(items), Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
    <e: Primary> => e,
}

Ands<T>: Vec<T> = {
    <v:(T AndsSep)+> <e:T> => {
        let mut res = Vec::new();
        for (it, _sep) in v.into_iter() {
            res.push(it);
        }
        res.push(e);
        res
    },
    <e:T> AndsSep => vec![e],
};

AndsSep: () = <l:@L> AmpersandTok+ <r:@R> => ();


Calculate: WithLocation<TypeAst> = { Or };

Or: WithLocation<TypeAst> = {
    <l:@L> <left: Or> DoublePipeTok <right: And> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#or".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <t: And> => t,
}

And: WithLocation<TypeAst> = {
    <l:@L> <left: And> DoubleAmpersandTok <right: Compare> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#and".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <t: Compare> => t,
}

Compare: WithLocation<TypeAst> = {
    <l:@L> <left: Compare> EqTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Eq {
            left: Box::new(left),
            right: Box::new(right),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> NeqTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Neq {
            left: Box::new(left),
            right: Box::new(right),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> LtTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#lt".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> LteTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#lte".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> GtTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#gt".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> GteTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#gte".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: Compare> IsTok <right: AddSub> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#is".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <t: AddSub> => t,
}

AddSub: WithLocation<TypeAst> = {
    <l:@L> <left: AddSub> <op_l:@L> PlusTok <op_r:@R> <right: Mod> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#add".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: AddSub> MinusTok <right: Mod> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#sub".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <t: Mod> => t,
}

Mod: WithLocation<TypeAst> = {
    <l:@L> <left: Mod> PercentTok <right: MulDiv> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#mod".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <t: MulDiv> => t,
}

MulDiv: WithLocation<TypeAst> = {
    <l:@L> <left: MulDiv> StarTok <right: Factor> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#mul".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <left: MulDiv> SlashTok <right: Factor> <r:@R> => {
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::Variable("op#div".to_string()), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![(left, NonZero::new(1).unwrap()), (right, NonZero::new(1).unwrap())]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <f: Factor> => f,
}


Binding: (GenericPattern, WithLocation<TypeAst>) = {
    <branch: Generic> AssignTok <value: Type> => (branch, value)
};

Let: (GenericPattern, WithLocation<TypeAst>) = {
    LetTok <binding: Binding> SemicolonTok => binding,
}

ExtendDef: (String, WithLocation<TypeAst>, usize, usize) = {
    // extend label: extend_type;
    <l:@L> ExtendTok <id_l:@L> <id: Ident> <id_r:@R> ColonTok <expr: Type> SemicolonTok <r:@R> => {
        (id, expr, id_l, id_r)
    },
}

Discard: WithLocation<TypeAst> = {
    <l:@L> DiscardTok <e: Type> SemicolonTok <r:@R> => {
        e
    },
}

Recursive: (String, GenericPattern, WithLocation<TypeAst>) = {
    // loop label: pattern = initialize_value;
    <l:@L> LoopTok <id: Ident> ColonTok <binding: Binding> SemicolonTok <r:@R> => {
        (id, binding.0, binding.1)
    },
}

Expression: WithLocation<TypeAst> = {
    <l:@L> LetTok <branch: Generic> SemicolonTok <expr: Type> <r:@R> => {
        WithLocation::new(TypeAst::Match {
            branches: vec![(branch, expr)],
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> <let_expr: Let> <e: Type> <r:@R> => {
        match e.value() {
            TypeAst::Expression {
                binding_patterns,
                binding_types,
                body,
            } => {
                let mut new_patterns = binding_patterns.clone();
                let mut new_types = binding_types.clone();
                let (branch, binding_value) = let_expr;
                new_patterns.insert(0, branch);
                new_types.insert(0, binding_value);
                WithLocation::new(TypeAst::Expression {
                    binding_patterns: new_patterns,
                    binding_types: new_types,
                    body: body.clone(),
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            }
            _ => {
                let (branch, binding_value) = let_expr;
                WithLocation::new(TypeAst::Expression {
                    binding_patterns: vec![branch],
                    binding_types: vec![binding_value],
                    body: Box::new(e),
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            },
        }
    },
    <l:@L> <extend_expr: ExtendDef> <e: Type> <r:@R> => {
        match e.value() {
            TypeAst::Expression {
                binding_patterns,
                binding_types,
                body,
            } => {
                let mut new_patterns = binding_patterns.clone();
                let mut new_types = binding_types.clone();
                new_patterns.insert(0, GenericPattern::Standard {
                    vars: vec![
                        WithLocation::new(extend_expr.0.clone(), Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref())
                    ],
                    pattern: WithLocation::new(
                        TypeAst::Variable(extend_expr.0.clone()),
                        Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                    ),
                    constraint: (
                        WithLocation::new(TypeAst::Variable(extend_expr.0.clone()), Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()),
                        WithLocation::new(
                            TypeAst::Top,
                            Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                        )
                    ),
                });
                new_types.insert(0, WithLocation::new(
                    TypeAst::Apply {
                        func: Box::new(WithLocation::new(
                            TypeAst::Variable("op#add".to_string()),
                            Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                        )),
                        arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![
                            (extend_expr.1, NonZero::new(1).unwrap()),
                            (WithLocation::new(
                                TypeAst::Variable(extend_expr.0),
                                Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                            ), NonZero::new(1).unwrap()),
                        ]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
                    },
                    Some(SourceLocation::new(source.clone(), l..r)).as_ref()
                ));
                WithLocation::new(TypeAst::Expression {
                    binding_patterns: new_patterns,
                    binding_types: new_types,
                    body: body.clone(),
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            }
            _ => WithLocation::new(TypeAst::Expression {
                binding_patterns: vec![GenericPattern::Standard {
                    vars: vec![
                        WithLocation::new(extend_expr.0.clone(), Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref())
                    ],
                    pattern: WithLocation::new(
                        TypeAst::Variable(extend_expr.0.clone()),
                        Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                    ),
                    constraint: (
                        WithLocation::new(TypeAst::Variable(extend_expr.0.clone()), Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()),
                        WithLocation::new(
                            TypeAst::Top,
                            Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                        )
                    ),
                }],
                binding_types: vec![WithLocation::new(
                    TypeAst::Apply {
                        func: Box::new(WithLocation::new(
                            TypeAst::Variable("op#add".to_string()),
                            Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                        )),
                        arg: Box::new(WithLocation::new(TypeAst::Tuple(vec![
                            (extend_expr.1, NonZero::new(1).unwrap()),
                            (WithLocation::new(
                                TypeAst::Variable(extend_expr.0),
                                Some(SourceLocation::new(source.clone(), extend_expr.2..extend_expr.3)).as_ref()
                            ), NonZero::new(1).unwrap()),
                        ]), Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
                    },
                    Some(SourceLocation::new(source.clone(), l..r)).as_ref()
                )],
                body: Box::new(e),
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
        }
    },
    <l:@L> <discard_expr: Discard> <e: Type> <r:@R> => {
        match e.value() {
            TypeAst::Expression {
                binding_patterns,
                binding_types,
                body,
            } => {
                let mut new_patterns = binding_patterns.clone();
                let mut new_types = binding_types.clone();
                new_patterns.insert(0, GenericPattern::Standard {
                    vars: vec![],
                    pattern: WithLocation::new(TypeAst::DiscardPattern, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                    constraint: (
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                    ),
                });
                new_types.insert(0, discard_expr);
                WithLocation::new(TypeAst::Expression {
                    binding_patterns: new_patterns,
                    binding_types: new_types,
                    body: body.clone(),
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            }
            _ => WithLocation::new(TypeAst::Expression {
                binding_patterns: vec![GenericPattern::Standard {
                    vars: vec![],
                    pattern: WithLocation::new(TypeAst::DiscardPattern, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                    constraint: (
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                    ),
                }],
                binding_types: vec![discard_expr],
                body: Box::new(e),
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
        }
    },
}

Loop: WithLocation<TypeAst> = {
    <l:@L> <rec_expr: Recursive> <e: Type> <r:@R> => {
        let (id, branch, init) = rec_expr;
        WithLocation::new(TypeAst::Apply {
            func: Box::new(WithLocation::new(TypeAst::FixPoint {
                param_name: id,
                expr: Box::new(WithLocation::new(TypeAst::Match {
                    branches: vec![(branch, e)],
                }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            arg: Box::new(init),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}

HandleWith: WithLocation<TypeAst> = {
    <l:@L> HandleTok <binding: Binding> WithTok <handler: Type> SemicolonTok <expr: Type> <r:@R> => {
        let (branch, binding_value) = binding;
        WithLocation::new(TypeAst::HandleWith {
            closure: Box::new(WithLocation::new(TypeAst::Match {
                branches: vec![(branch, expr)],
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            init_val: Box::new(binding_value),
            handler: Box::new(handler),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
    <l:@L> HandleTok WithTok <handler: Type> SemicolonTok <expr: Type> <r:@R> => {
        WithLocation::new(TypeAst::HandleWith {
            closure: Box::new(WithLocation::new(TypeAst::Match {
                branches: vec![(GenericPattern::Standard {
                    vars: vec![],
                    pattern: WithLocation::new(TypeAst::DiscardPattern, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                    constraint: (
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref()),
                        WithLocation::new(TypeAst::Top, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
                    ),
                }, expr)],
            }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())),
            init_val: Box::new(
                WithLocation::new(TypeAst::DiscardPattern,
                Some(SourceLocation::new(source.clone(), l..r)).as_ref())
            ),
            handler: Box::new(handler),
        }, Some(SourceLocation::new(source.clone(), l..r)).as_ref())
    },
}


pub Type: WithLocation<TypeAst> = {
    <h: HandleWith> => h,
    <l: Loop> => l,
    <e: Expression> => e,
    <t: Tuple> => t,
}
